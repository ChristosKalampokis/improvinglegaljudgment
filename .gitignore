# --- Python / environments ---
venv/
__pycache__/
*.pyc

# --- Node tooling used only to generate the .docx guides ---
node_modules/
package.json
package-lock.json
create_code_doc.js
create_execution_guide.js

# --- Full fine-tuned encoder checkpoints (438-499 MB each, over GitHub's 100 MB limit) ---
