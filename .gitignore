*.pt
*.bin

# --- Run logs (large, machine-specific paths); results/*.json are the record ---
logs/

# --- Thesis drafts, LaTeX build files and Word round-trip copies ---
thesis/
GitHub_Upload_Guide.*

# --- Word documents (guides, editable thesis copies): only code, README and results are published ---
*.docx

# --- Launchers tied to this PC (local credential paths) ---
*.bat
launch_experiments.py

# --- Blank model-card templates that PEFT writes next to every saved adapter ---
results/*_lora_best/README.md

# --- Debug output of a removed script ---
results/debug_cot_responses.json

